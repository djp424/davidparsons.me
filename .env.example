# Where the contact form sends. Server-side only — it is never rendered into
# any page, so address harvesters scraping the HTML don't find it.
CONTACT_EMAIL=you@example.com

# Strava, for the live "this week" band on /athlete. Server-side only: none of
# these are NEXT_PUBLIC_, and lib/strava.ts is marked `server-only` so they
# cannot be imported into anything the browser downloads.
#
# The first two are on your app's page at https://www.strava.com/settings/api.
# The third comes from `npm run strava:token`, which authorises the app once in
# a browser and prints it — Strava access tokens expire after six hours, so a
# refresh token is the credential that actually gets stored.
#
# Leave them unset and the week section is simply not rendered.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
